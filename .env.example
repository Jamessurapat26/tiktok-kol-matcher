# Copy to .env and fill in what you need. Blank values fall back to the defaults.

# ----- Keys for live mode: most setups only need these. Without APIFY_TOKEN the service runs in demo mode. -----

# Apify token for the live Facebook reader, TikTok search, and profile enrichment.
APIFY_TOKEN=
# OpenRouter key for the default LLM. If you change LLM_BASE_URL, use that provider's key instead.
LLM_API_KEY=
# Jina key. Optional for the live web reader (blank sends requests without a key); required for live web research on the brand.
JINA_API_KEY=

# ----- Optional settings: leave blank to use the defaults. -----

# Service mode: 1 forces demo (all mocks), 0 forces live. Blank: live when APIFY_TOKEN is set.
DEMO_MODE=

# Estimated Apify budget for one job or CLI run. Blank: 1.55. A run starts only if its estimate still fits; skipped runs become warnings.
APIFY_JOB_BUDGET_USD=
# Budget kept back for profile enrichment while TikTok search runs. Blank: 0.70. Must be below APIFY_JOB_BUDGET_USD.
APIFY_ENRICH_RESERVE_USD=
# Per-run cap for each TikTok search. Blank: 0.50.
APIFY_TIKTOK_SEARCH_MAX_CHARGE_USD=
# Per-run cap for each TikTok profile enrichment. Blank: 0.50.
APIFY_TIKTOK_PROFILE_MAX_CHARGE_USD=
# Per-run cap for each Facebook page or posts run. Blank: 0.50.
APIFY_FACEBOOK_MAX_CHARGE_USD=
# Videos returned per TikTok search query. Blank: 15. Range 1-50.
TIKTOK_RESULTS_PER_QUERY=
# Videos fetched per enriched TikTok profile. Blank: 10. Range 1-30.
TIKTOK_PROFILE_VIDEOS=
# Discovery target of Thai creators. Blank: 30.
DISCOVERY_MIN_THAI_CANDIDATES=
# Maximum discovery search rounds. Blank: 3. Range 1-5.
DISCOVERY_MAX_ROUNDS=
# Allow the direct fetcher to reach exactly 198.18.0.0/15 as well as public addresses.
# For sandboxes whose DNS returns that fake-IP proxy range. Blank: off. Enabling it weakens the private-address guard.
WEB_FETCH_ALLOW_PROXY_RANGE=

# OpenAI-compatible endpoint for the live LLM. Default: https://openrouter.ai/api/v1
LLM_BASE_URL=
# Model name at that endpoint. Default: deepseek/deepseek-v4.1-flash-1017
LLM_MODEL=
# Fallback LLM tokens, used in this order when LLM_API_KEY is blank. They are sent to LLM_BASE_URL, so set it to match.
NVIDIA_API_KEY=
OPENAI_API_KEY=
# Per-attempt request timeout in seconds. Default: 60
LLM_TIMEOUT=
# Retries on timeout, connection error, 408, 429, and 5xx. Default: 2. 0 disables.
LLM_MAX_RETRIES=
# Seconds before the first retry; doubles each retry. Default: 2. Retry-After is honoured up to 30 s.
LLM_RETRY_BACKOFF=
# Max completion tokens per request. Default: 16000
LLM_MAX_TOKENS=
# Sampling temperature. Default: 0.2
LLM_TEMPERATURE=
# How to turn model thinking off: off, system, extra_body, or both. Blank: extra_body for Nemotron on NVIDIA only, otherwise off.
LLM_DISABLE_REASONING=
# Message sent when LLM_DISABLE_REASONING is system or both. Default: /no_think
LLM_NO_THINK_MESSAGE=

# Local embedding model (needs `uv sync --extra embed`). Default: google/embeddinggemma-2
EMBED_MODEL=
# Torch device for the embedder. Default: cpu
EMBED_DEVICE=
# Texts per embedding batch. Default: 32
EMBED_BATCH_SIZE=
# Embedding size: 128, 256, 512, or 768. Default: 768
EMBED_DIM=
# float32 or bfloat16. Default: float32
EMBED_DTYPE=
# Hugging Face token, needed when the embedding model is gated.
HF_TOKEN=

# The settings below must be unset, not blank, to take their defaults.
# Cache root for web, Facebook, profile enrichment, and embedding caches; TikTok search is not cached. Default: <repo>/data/cache
# KOL_CACHE_DIR=
# SQLite jobs database for the API. Default: data/jobs.db (relative to the working directory)
# JOBS_DB=
# Comma-separated browser origins allowed by CORS. Default: http://localhost:5173
# CORS_ORIGINS=
# Jobs the API runs at once. Default: 2
# JOB_WORKERS=
# Jobs queued or running before POST /api/jobs answers 429. Default: 20
# MAX_QUEUED_JOBS=
